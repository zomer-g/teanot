# --- Secrets (set on xhostd with set_env ... secret=True) ---
# Language-model keys can instead be entered in the admin panel (tab "מודל שפה"); a key entered there wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Required to store API keys from the admin panel: any random string of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes keys already stored in the panel unreadable (they must be entered again).
SETTINGS_ENCRYPTION_KEY=
TAGIT_API_KEY=
# Optional: a separate key for the guidelines API (defaults to TAGIT_API_KEY)
TAGIT_GUIDELINES_API_KEY=

# --- Access ---
# Comma-separated emails that are always admins (bootstrap; cannot be locked out)
ADMIN_EMAILS=guy@z-g.co.il
# Hostnames the xhostd SSO token may be issued for (e.g. teanot-zomerg.xhostd.app,research.z-g.co.il)
XHOST_AUTH_AUDIENCES=

# --- Optional tuning ---
# Default Claude model until an admin picks one in the panel
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# Server-side refusal fallbacks (on by default); set to "off" to disable
CLAUDE_FALLBACKS=on
TAGIT_API_URL=https://tag-it.biz
TAGIT_SENTENCING_SCOPE=1
TAGIT_TIMEOUT_MS=120000

# --- Local development only ---
# No DATABASE_URL locally → embedded PGlite in ./.pglite
# Impersonate a signed-in user (ignored when NODE_ENV=production)
DEV_AUTH_EMAIL=guy@z-g.co.il
